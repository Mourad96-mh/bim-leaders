# --- Base de données -------------------------------------------------------
# Chaîne de connexion MongoDB Atlas.
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster.xxxxx.mongodb.net/bim-leaders

# --- Authentification du dashboard -----------------------------------------
# Chaîne aléatoire longue. La régénérer déconnecte tout le monde.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=12h

# --- CORS ------------------------------------------------------------------
# Origines autorisées à appeler l'API, séparées par des virgules.
# ⚠️ Sans valeur, TOUTES les origines sont acceptées : ne jamais laisser vide
# en production.
CORS_ORIGIN=https://bimleaders.ma,https://www.bimleaders.ma

# --- Cloudinary (photos de chantier et pièces jointes) ---------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Render fournit PORT automatiquement ; en local, 4000 par défaut.
# PORT=4000
